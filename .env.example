# Walrus Memory, Sui testnet ("staging") relayer. The SDK defaults to MAINNET if you leave this out.
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=
# Comma-separated delegate keys (hex); users are spread across them to share the per-key rate limit.
MEMWAL_KEYS=
# Owner wallet (suiprivkey1...). Only used by `pnpm init-account`; the running app never needs it.
OWNER_SUI_PRIVATE_KEY=
# DeepSeek (OpenAI-compatible, api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Random secrets: `openssl rand -hex 32`. NS_SALT must never change, or users lose their namespace.
SESSION_SECRET=
NS_SALT=
# Telegram bot from @BotFather. Also run /setdomain in BotFather with your web domain for the login button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://your-app.vercel.app
